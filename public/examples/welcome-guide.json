  "nodes": [
    {
      "id": "mui504ak-l5chf2q08",
      "name": "Welcome to Treelab!",
      "templateId": "SectionTemplate",
      "data": {
        "2025-08-19T08:57:55.257Zi4vl4q4": "Welcome to Treelab!",
        "2025-08-19T08:57:55.257Z0wu6pdt": "This is your first tree, a brief guide to help you get started. You can edit, add to, or delete this entire tree at any time from the **Roots** page."
      },
      "isStarred": false,
      "userId": "6a85c5d18bfa09e9a430bb24",
