    {
      "id": "mui504ak-w1ec27ynh",
      "name": "Clones",
      "templateId": "FeatureTemplate",
      "data": {
        "2025-08-19T08:57:55.257Z0m2c3ze": "Clones",
        "2025-08-19T08:57:55.257Z1ddpobd": "If you copy a node and paste as clone you will have an exact replica of the original node. Changes on one of the two will immediately be reflected on the other. (Technically, it is the exact same node, but with multiple parents).\n\nA Cloned node is identified by an icon next to his name. Hovering the mouse pointer on this icon will make appear a list of all the clones locations.",
        "2025-08-24T06:58:51.175Z0.27552086254079367": "Normal"
      },
      "isStarred": false,
      "userId": "6a85c5d18bfa09e9a430bb24",
