    {
      "id": "mui504ak-stq4xp2nn",
      "name": "Node actions",
      "templateId": "FeatureTemplate",
      "data": {
        "2025-08-19T08:57:55.257Z0m2c3ze": "Node actions",
        "2025-08-24T06:58:51.175Z0.27552086254079367": "Normal",
        "2025-08-19T08:57:55.257Z1ddpobd": "\nThe main actions are available directly on the node, just to the right of its name. Hovering every icon with the mouse will reveal its function.\n\n- Preview: open a viewer focused on the specific node\n- Edit: Allows to change the node fields\n- Expand/Collapse all: expand and collapses the node and all its descendants\n- Move up and Move down: move the node with respect to its siblings\n- Add child and Add sibling: create a new node as child of the node or sibling\n\nUse the **more options** icon (the three dots) or right click on any node to see all the other actions you can perform, like changing the node type, cut/copy/paste, and delete the node.\n"
      },
      "isStarred": false,
      "userId": "6a85c5d18bfa09e9a430bb24",
      "treeId": "6ab78463ce927feec12b5f6b",
      "parentIds": [
