    {
      "id": "mui504ak-zrljivi6j",
      "name": "Core Features",
      "templateId": "SectionTemplate",
      "data": {
        "2025-08-19T08:57:55.257Zi4vl4q4": "Core Features",
        "2025-08-19T08:57:55.257Z0wu6pdt": "Treelab is built around a few key concepts. Here are some of the features you can explore."
      },
