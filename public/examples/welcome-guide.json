    {
      "id": "mui504ak-0z1fytxaw",
      "name": "Export",
      "templateId": "FeatureTemplate",
      "data": {
        "2025-08-24T06:58:51.175Z0.27552086254079367": "Normal",
        "2025-08-19T08:57:55.257Z0m2c3ze": "Export",
        "2025-08-19T08:57:55.257Z1ddpobd": "The entire or any subset of its nodes can be exported as json file, zip archive (with attachments and pictures), or html page.\nThe node preview window allows also to print nicely a pdf file."
      },
