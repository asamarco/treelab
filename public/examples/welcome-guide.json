    {
      "id": "mui504ak-mp07qxzpc",
      "name": "Customizable layout",
      "templateId": "FeatureTemplate",
      "data": {
        "2025-08-19T08:57:55.257Z0m2c3ze": "Customizable layout",
        "2025-08-19T08:57:55.257Z1ddpobd": "Choose between single and two-panel view, normal or compact layout, and light or dark theme to adjust to your preferences. On top of existing layouts, the \"Explorer view\" allows to drill down into the tree to focus on what really matters and navigate complex structures with ease.\nAll these different modes can be toggled from the top menu bar.",
        "2025-08-24T06:58:51.175Z0.27552086254079367": "Normal"
      },
