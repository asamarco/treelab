    {
      "id": "mui504ak-vmm2ilpg5",
      "name": "Teams",
      "templateId": "FeatureTemplate",
      "data": {
        "2025-08-19T08:57:55.257Z0m2c3ze": "Teams",
        "2025-08-19T08:57:55.257Z1ddpobd": "Administrators can create teams, assign leaders, and organize users into functional groups (such as departments or regions). Once a team is established, trees can be shared with the entire group at once, automatically granting all members specific permissions.\n",
        "2025-08-24T06:58:51.175Z0.27552086254079367": "Experimental"
      },
