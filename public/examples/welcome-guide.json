    {
      "id": "mui504ak-wu5hy6vit",
      "name": "Templates",
      "templateId": "FeatureTemplate",
      "data": {
        "2025-08-19T08:57:55.257Z0m2c3ze": "Templates",
        "2025-08-19T08:57:55.257Z1ddpobd": "Templates are the blueprint for your data. You can combine various field types like:\n\n- Text & Text Areas (with HTML support!)\n- Numbers & Dates\n- Dropdowns (static or dynamic)\n- Pictures & Attachments\n- Tables\n- Checkboxes and checklists\n- XY plots\n- Markdown\n\nGo to the templates to create new templates and modify the existing ones",
        "2025-08-24T06:58:51.175Z0.27552086254079367": "Normal"
      },
      "isStarred": false,
      "userId": "6a85c5d18bfa09e9a430bb24",
