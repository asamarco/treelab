    {
      "id": "mui504ak-niqwljr7h",
      "name": "Getting Started",
      "templateId": "SectionTemplate",
      "data": {
        "2025-08-19T08:57:55.257Zi4vl4q4": "Getting Started",
        "2025-08-19T08:57:55.257Z0wu6pdt": "Here's a quick overview of the basic workflow:\n\n**1. Create Templates:** Go to the *Templates* page to define the structure of your data.\n\n**2. Build Your Tree:** Come back here to add nodes using the templates you created.\n\n**3. Organize:** Add new nodes as sibling or children, reorder them freely and create nested hierarchies.\n "
      },
      "isStarred": false,
      "userId": "6a85c5d18bfa09e9a430bb24",
      "treeId": "6ab78463ce927feec12b5f6b",
