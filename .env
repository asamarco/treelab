# Database Credentials & Connection
MONGODB_USER=admin   # MongoDB username (used by both the app and the mongo container on first init)
MONGODB_PASSWORD=secret # MongoDB password (used by both the app and the mongo container on first init)
MONGODB_URI=mongodb://${MONGODB_USER}:${MONGODB_PASSWORD}@mongo:27017/treelab?authSource=admin# replace 'mongo' if not using the default docker-compose file


# Security & Encryption Keys
DB_ENCRYPTION_KEY=ThisIsASecretKeyForEncryption123 # 32-character AES-256-GCM secret key for field/payload encryption
JWT_SECRET_KEY=your_super_secret_jwt_key_at_least_32_chars # Secret key for signing and verifying user session JWTs (at least 32 chars)

# Authentication settings
REQUIRE_AUTHENTICATION=true # Set to false to disable user login prompts
USERID=test # Fallback active user account ID when REQUIRE_AUTHENTICATION=false
SECURE_COOKIE=true # Set to false to allow remote clients to authenticate over http (no TLS).

# Session cookie duration parameters
SESSION_EXPIRY_HOURS=12 # Cookie session duration in hours for standard logins
SESSION_REMEMBER_ME_DAYS=30 # Cookie session duration in days when "Remember Me" is checked

# REST API Feature Flag
ENABLE_API=false # Set to true to enable /api/v1 REST API endpoints and PAT management UI

# REST API rate limiting
API_RATE_LIMIT_REQUESTS=120 # Maximum allowed requests per user per time window
API_RATE_LIMIT_WINDOW_SECONDS=60 # Rate limit reset time window duration in seconds
